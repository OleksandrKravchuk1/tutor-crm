{
  "name": "tutor-crm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @tutor-crm/shared",
    "mobile": "npm run start -w @tutor-crm/mobile",
    "android": "npm run android -w @tutor-crm/mobile",
    "ios": "npm run ios -w @tutor-crm/mobile",
    "api": "npm run start:dev -w @tutor-crm/api",
    "shared:build": "npm run build -w @tutor-crm/shared",
    "shared:dev": "npm run dev -w @tutor-crm/shared",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
